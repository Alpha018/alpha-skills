{
  "name": "@alpha018/nextdns-mcp",
  "version": "1.0.1",
  "description": "Local stdio MCP server exposing the NextDNS REST API as tools.",
  "type": "module",
  "author": "github.com/alpha018",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alpha018/alpha-skills.git",
    "directory": "mcp-servers/nextdns"
  },
  "bin": {
    "nextdns-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "node dist/index.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.1",
    "@semantic-release/npm": "^12.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "semantic-release": "^24.2.3",
    "semantic-release-monorepo": "^8.0.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0"
  },
  "engines": {
    "node": ">=22"
  }
}
